<question type="multichoice"><name><text>Module 2 · Lesson 7 · Check 12</text></name><questiontext format="html"><text><![CDATA[Exercise 1. Identify ܚܙܝܬ (<i>ḥzēt</i>).]]></text></questiontext><generalfeedback format="html"><text><![CDATA[]]></text></generalfeedback><single>true</single><shuffleanswers>true</shuffleanswers><answer fraction="100" format="html"><text><![CDATA[Root ḥ-z-y, Peal perfect 1 c.sg.: 'I saw']]></text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer><answer fraction="0" format="html"><text><![CDATA[Root ḥ-z-y, Peal perfect 3 m.sg.: 'he saw']]></text><feedback format="html"><text><![CDATA[That is <i>ḥzā</i>.]]></text></feedback></answer><answer fraction="0" format="html"><text><![CDATA[Root ḥ-z-t, Peal perfect 3 m.sg.]]></text><feedback format="html"><text><![CDATA[The final ܬ is a suffix.]]></text></feedback></answer><answer fraction="0" format="html"><text><![CDATA[Root ḥ-z-y, Peal perfect 3 f.pl.]]></text><feedback format="html"><text><![CDATA[Not with -ēt.]]></text></feedback></answer></question>
