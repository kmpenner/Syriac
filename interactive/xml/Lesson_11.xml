<tr>
<td style="text-align: left;"><strong>us (1 c.pl.)</strong></td>
<td style="text-align: left;">ـܢ (-an)</td>
<td style="text-align: left;">ܩܛܠܢ</td>
<td style="text-align: left;">qaṭlan</td>
<td style="text-align: left;">he killed us</td>
</tr>
<tr>
<td style="text-align: left;"><strong>you (2 m.pl.)</strong></td>
<td style="text-align: left;">ـܟܘܢ (-kūn)</td>
<td style="text-align: left;">ܩܛܠܟܘܢ</td>
<td style="text-align: left;">qaṭlkūn</td>
<td style="text-align: left;">he killed you (mpl)</td>
</tr>
<tr>
<td style="text-align: left;"><strong>you (2 f.pl.)</strong></td>
<td style="text-align: left;">ـܟܝܢ (-kēn)</td>
<td style="text-align: left;">ܩܛܠܟܝܢ</td>
<td style="text-align: left;">qaṭlkēn</td>
<td style="text-align: left;">he killed you (fpl)</td>
</tr>
<tr>
<td style="text-align: left;"><strong>them (3 m.pl.)</strong></td>
<td style="text-align: left;">ـܗܘܢ (-hūn)</td>
<td style="text-align: left;">ܩܛܠܗܘܢ</td>
<td style="text-align: left;">qaṭlhūn</td>
