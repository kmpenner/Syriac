<td style="text-align: left;">to sin</td>
<td style="text-align: left;">(intransitive usually)</td>
</tr>
<tr class="even">
<td style="text-align: left;">ܟ.ܪ.ܗ (k-r-h)</td>
<td style="text-align: left;">kurhānā (Noun)</td>
<td style="text-align: left;">illness, sickness</td>
<td style="text-align: left;"></td>
</tr>
<tr class="odd">
<td style="text-align: left;">ܚ.ܛ.ܝ (ḥ-ṭ-y)</td>
<td style="text-align: left;">ḥṭītā (Noun)</td>
<td style="text-align: left;">sin</td>
<td style="text-align: left;"></td>
</tr>
<tr class="even">
<td style="text-align: left;">ܢ.ܦ.ܠ (n-p-l)</td>
<td style="text-align: left;">npal (Peal)</td>
<td style="text-align: left;">to fall</td>
<td style="text-align: left;">npal b-kurhānā (fell ill)</td>
</tr>
<tr class="odd">
